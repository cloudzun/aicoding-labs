# 复制为 .env 后填入真实值。.env 不提交。
# 统一走 magpie 网关：生成 + 嵌入（schema linking 用）
MAGPIE_BASE=http://127.0.0.1:3425
MAGPIE_KEY=<MAGPIE_KEY>
MODEL_MAIN=opencode-go/gpt-6-luna
MODEL_REASONER=opencode-go/deepseek-v4.1-flash
EMBED_BASE=http://127.0.0.1:3425/v1
EMBED_KEY=<MAGPIE_KEY>
EMBED_MODEL=siliconflow/Qwen/Qwen3-Embedding-4B

# 数据库
DB_PATH=data/aicoding.db
DB_SEED=20261020

# 安全闸
MAX_ROWS=1000
QUERY_TIMEOUT_S=10
MAX_CORRECTION_ATTEMPTS=2

PORT=4181
