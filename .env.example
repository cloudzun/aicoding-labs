# ===== 供应商选择：siliconflow（默认，公网）| magpie（内网可选）=====
# 复制为各案例目录下的 .env 后填入自己的 key；切勿提交真实 key。
# 本模板只是兜底：scripts/setup.ps1 会优先复制 cases\<案例>\.env.example（键名与端口都和该案例对得上）。
LLM_PROVIDER=siliconflow

# ---------- 档 A：硅基流动（一个 key 覆盖 chat + embedding + rerank）----------
SILICONFLOW_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_KEY=<YOUR_SILICONFLOW_KEY>

# 模型键按案例不同——代码只读下列键名，写错不会报错、只会静默失效：
#   案例一 RAG      ：MODEL_MAIN / MODEL_REASONER（判官）/ EMBED_MODEL / RERANK_MODEL
#   案例二 NL2SQL   ：MODEL_MAIN
#   案例三 合同审查 ：MODEL_MAIN / MODEL_SEMANTIC（语义引擎）
MODEL_MAIN=Qwen/Qwen2.5-72B-Instruct
MODEL_REASONER=deepseek-ai/DeepSeek-V3
# 仅案例三读取；若用本模板（而非案例三自带模板）跑案例三，取消下一行注释
# MODEL_SEMANTIC=deepseek-ai/DeepSeek-V3
EMBED_MODEL=Qwen/Qwen3-Embedding-4B
RERANK_MODEL=Qwen/Qwen3-Reranker-4B
MIN_RERANK_SCORE=0.30

# ---------- 档 B：内网 magpie（不公开分发，默认注释）----------
# LLM_PROVIDER=magpie
# MAGPIE_BASE=http://127.0.0.1:3425
# MAGPIE_KEY=<MAGPIE_KEY>
# MODEL_MAIN=opencode-go/gpt-6-luna
# MODEL_REASONER=opencode-go/deepseek-v4.1-flash
# MODEL_SEMANTIC=opencode-go/deepseek-v4.1-flash
# EMBED_BASE=http://127.0.0.1:3425/v1
# RERANK_BASE=http://127.0.0.1:3425/v1

# ---------- 端口（案例一 4180 / 案例二 4181 / 案例三 4182）----------
# 手动复制本模板时，把下一行改成该案例的端口并取消注释；setup.ps1 会自动写入对应值。
# PORT=4180
